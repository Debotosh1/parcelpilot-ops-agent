# Copy to .env and fill in. Only GROQ_API_KEY is required.
GROQ_API_KEY=gsk_your_key_here

# Any Groq model with tool-calling support. Defaults shown.
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TEMPERATURE=0.1
GROQ_MAX_TOKENS=1600
GROQ_TIMEOUT_S=60

# Agent behaviour
MAX_AGENT_STEPS=8
PENDING_ACTION_TTL_S=900

# Data + logging
DATA_DIR=./data
LOG_LEVEL=INFO
